{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run lint:db",
    "check:shared": "node scripts/check-shared.mjs",
    "pallav:css": "node scripts/bundle-pallav-css.mjs",
    "test": "node --test tests/*.test.ts && npm run test:server",
    "test:server": "tsx --import ./src/server/lib/node-hooks/register.ts --test tests/server/*.test.ts",
    "build:check": "node scripts/build-check.mjs",
    "lint:db": "cd ../common/db && node \"../../web-app/node_modules/eslint/bin/eslint.js\" scripts",
    "lint:sql": "tsx ../common/db/scripts/lint-sql.ts",
    "seeds:check": "tsx ../common/db/scripts/generate-platform-seeds.ts --check && tsx ../common/db/scripts/generate-hotel-seeds.ts --check && tsx ../common/db/scripts/generate-permission-catalog.ts --check",
    "test:db": "tsx --import ./src/server/lib/node-hooks/register.ts --test --test-concurrency=1 --test-timeout=600000 tests/db/*.test.ts",
    "security:decoy": "tsx --import ./src/server/lib/node-hooks/register.ts scripts/make-canary-decoy.ts",
    "db:pg": "tsx --import ./src/server/lib/node-hooks/register.ts ../common/db/scripts/pg-instance.ts",
    "db:cli": "tsx --import ./src/server/lib/node-hooks/register.ts ../common/db/scripts/cli.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.18.1",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
