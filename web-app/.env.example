# Variable NAMES only. Real values go in web-app/.env.local, which is git-ignored. Never put a value in this file.
# This file lists ONLY what the running app reads (Next.js loads web-app/.env.local into the web server).
# What each one means: docs/ENVIRONMENT.md
# Script-only secrets (PGSUPERUSER_URL, PG_OWNER_URL, PG_TEST_OWNER_URL) live in db/.env.local, never here: see db/.env.example.

NODE_ENV=
LOG_LEVEL=

# Limited app user (hms_app) on HMS's own PostgreSQL (postgresql://..., 127.0.0.1:5433, database hms). Written by `db:cli setup`. Optional until the database exists.
DATABASE_URL=
# One shared connection pool for all hotels (default 20).
DB_POOL_MAX=

# Server secret for keyed hashes of one-time codes and sign-in identifiers (base64, at least 32 bytes). Written by `db:cli setup`.
HMS_HASH_KEY=

# The address people open in a browser (invitation e-mail links are built from it), no path. Optional; default http://localhost:3000.
HMS_PUBLIC_URL=

# How many proxies in front of the app each add one entry to X-Forwarded-For (the caller's address is the entry that many from the right). Default 1 (Caddy, nginx, Vercel: ignored there, always 1). 2 = a CDN then Caddy. 0 = no proxy: the header is not trusted.
HMS_PROXY_HOPS=

# How mail leaves: log (default; development: the terminal and db/.dev-mail.log, nothing is sent) or smtp (a real mail server; the next lines are then needed).
MAIL_DRIVER=
SMTP_HOST=
# 587 (STARTTLS) by default; 465 uses TLS from the first byte.
SMTP_PORT=
# true / false; default true only for port 465.
SMTP_SECURE=
# Mail account login (set both or neither).
SMTP_USER=
SMTP_PASS=
# Sender: noreply@hotel.in or Hotel Pallav <noreply@hotel.in> (Platform settings, mail sender, win when set).
SMTP_FROM=
# Base64 of exactly 32 random bytes. Encrypts the mail password the Super Admin saves in Platform settings > Mail (AES-256-GCM). Without it that password cannot be saved;
# the SMTP_* lines above keep working. Separate from HMS_SECRET_KEY.
SMTP_SECRET_KEY=

# Cloudflare Turnstile (the security check on sign-in, forgot password and the reset link). Set both or neither; unset = no check.
# The site key is public (the browser reads it); the secret key stays on the server. Add the hotel domain (and localhost for development) to the widget's hostnames in Cloudflare.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Where uploaded website photos are kept on disk (an absolute folder). Default: web-app/.data/media. Back this folder up with the database.
HMS_MEDIA_DIR=

# ---- Supabase (hosted PostgreSQL; docs/deploy/SUPABASE-MOVE-2026-10-18.md) ----
# The web app uses the TRANSACTION pooler (port 6543, ?sslmode=require) as hms_app:
#   DATABASE_URL=postgresql://hms_app:<password>@<pooler-host>:6543/postgres?sslmode=require
# and marks it as pooled (no connection start-up options are sent, every setting is transaction-local):
#   DB_POOLED=1
# Keep the pool small on a serverless host: DB_POOL_MAX=3 to 5 per function.
# Set-up, migrations and scripts use the DIRECT connection (db/.env.local: PG_CONSOLE_URL = the `postgres` role, PG_OWNER_URL = hms_owner), never the transaction pooler.
# Supabase runs PostgreSQL 17: `npm run db:cli -- setup --hosted` makes the uuidv7() shim in public by itself.
# Photos: MEDIA_DRIVER=s3 with Supabase Storage's S3 endpoint (S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_FORCE_PATH_STYLE=1), a PRIVATE bucket.
# ---- Hotel website designs (website-templates/docs/BACKEND.md) ----
# All three together, or none (the app will not start with only some). Without them a hotel sees the ten designs but cannot apply one.
# GITHUB_SITES_TOKEN: a GitHub fine-grained token for ONE repository (GITHUB_SITES_REPO), permission Contents: read and write. It only starts the "Create hotel site" workflow.
# GITHUB_SITES_REPO:  owner/name of the repository that holds website-templates/ and .github/workflows/create-hotel-site.yml.
# SITE_BUILD_SECRET:  at least 32 random characters; also saved as the repository secret SITE_BUILD_SECRET. The job signs its reports with it.
GITHUB_SITES_TOKEN=
GITHUB_SITES_REPO=
SITE_BUILD_SECRET=

# Amazon SES receiving (replies to a hotel's mail reach its Email inbox): the SNS topic the SES receipt rule publishes to, as arn:aws:sns:<region>:<account>:<name>. Optional; without it the
# address /api/v1/public/mail-inbound/<key> answers 404. The address itself (with its secret key) is shown to the Super Admin in Platform > Hotel mail.
HMS_INBOUND_SNS_TOPIC_ARN=

# GST lookup (platform 0167): the GST number field on a company finds the company's name and address, saved in platform.gst_registry so each GSTIN is asked of the service once.
# Optional; without both a GSTIN is still checked (state, PAN, check character) and saved records still answer. The key is a server secret: set it in Vercel, never in the browser.
# GST_LOOKUP_PROVIDER: gstinapi (www.gstinapi.in, key sent as x-api-key).
GST_LOOKUP_PROVIDER=
GST_LOOKUP_API_KEY=

# Base64 of exactly 32 random bytes. Seals ID, bank and IFSC numbers (decision 74; AES-256-GCM + a search index). Separate from HMS_SECRET_KEY and HMS_HASH_KEY.
# NEVER LOSE IT: without it the sealed numbers cannot be opened. Keep a copy apart from the database dumps.   Make one: openssl rand -base64 32
HMS_DATA_KEY=
