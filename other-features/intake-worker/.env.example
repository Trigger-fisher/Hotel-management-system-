# Copy to the root-only environment file on the VPS (/etc/intake-worker.env). Never commit the real one.
# Limited database login: it can SELECT/UPDATE intake_jobs and INSERT worker_heartbeat only (see sql/proposal.sql).
INTAKE_DATABASE_URL=postgresql://intake_worker:CHANGE_ME@db.your-project.supabase.co:5432/postgres?sslmode=require
# 32 random bytes, base64 encoded: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
INTAKE_MASTER_KEY=
INTAKE_CLAMD=tcp:clamd:3310
INTAKE_ALLOWED_HOSTS=your-project.supabase.co
# clamd's signature folder, mounted read only: the heartbeat carries the age of the Sanesecurity feeds (48-hour alert)
INTAKE_SIGNATURES_DIR=/var/lib/clamav
INTAKE_THREADS=
# Threads that may run a job's BACKGROUND part (cutter, merge, compress, upload) at once; empty = threads minus one, so one thread
# is always free for the next guest's form (the FAST part).
INTAKE_BACKGROUND_THREADS=
# onnxruntime threads per OCR model; empty = the CPUs this process may use (4 on the KVM 4).
INTAKE_OCR_THREADS=
# QR and barcode decoding: OFF (MJ, 5 Nov 2026: no QR for now). true turns the old QR reading and cross-checks back on.
INTAKE_READ_QR=false
# Conservative auto-enhance of the STORED copy only (levels, gentle white balance, mild denoise/sharpen); reading is unaffected. true|false
AUTO_ENHANCE=true
# Card cutter model: vit_t = MobileSAM (default, faster, the same cuts on every test sheet) or vit_b = Segment Anything; the image
# sets both. Without the file the classic finder is used (flag fallbackFinder).
CARDCUT_ARCH=vit_t
CARDCUT_MODEL=/srv/models/mobile_sam.pt
# Photo check: YuNet (MIT) + SFace (Apache-2.0) from opencv_zoo, fetched and checked by scripts/get_face_models.py; the image sets it.
# Without the files every photo outcome is "unclear" (no evidence either way). Face embeddings never leave memory.
FACE_MODELS_DIR=/srv/models/faces
# Clarity and photo thresholds: defaults in app/thresholds.py; any of them can be set here, for example
# CLARITY_DPI_UNCLEAR=150
# FACE_MISMATCH_BELOW=0.15
# the fast part's finder edge-fits the cards of one sheet side by side in this many threads
INTAKE_CUT_THREADS=4
