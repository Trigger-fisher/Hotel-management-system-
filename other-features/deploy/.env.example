# deploy/.env for the VPS. Copy:  cp .env.example .env && chmod 600 .env   (owner root). NEVER commit the real file.
# Each service receives ONLY its own names (docker-compose.yml maps them one by one); names are the ones in each folder's .env.example.
# Make every *_KEY a different random value:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- whole pack ----
# Your domain; nginx serves compressor.<domain>, scanner.<domain>, pdf.<domain>, reader.<domain>, gate.<domain>
HMS_DOMAIN=example.com
# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=you@example.com
# Image tag; scripts/update.sh and scripts/rollback.sh change this line. Leave it as is.
HMS_TAG=current

# ---- compressor (port 8080 inside) ----
COMPRESSOR_KEY=replace-with-a-random-string-of-at-least-32-characters
COMPRESSOR_ALLOWED_HOSTS=your-bucket.example.com
COMPRESSOR_MAX_CONCURRENCY=1
COMPRESSOR_QUEUE_SIZE=4
COMPRESSOR_MAX_UPLOAD_MB=100
COMPRESSOR_MAX_MEGAPIXELS=100
COMPRESSOR_MAX_PDF_PAGES=300
COMPRESSOR_JOB_TIMEOUT_S=300

# ---- antivirus (port 8081 inside; clamd inside the same container) ----
SCANNER_KEY=replace-with-a-random-string-of-at-least-32-characters
SCANNER_ALLOWED_HOSTS=your-quarantine-bucket.example.com,your-clean-bucket.example.com
SCANNER_QUARANTINE_ACTION=report
SCANNER_STRIP_URI=false
SCANNER_MAX_CONCURRENCY=2
SCANNER_QUEUE_SIZE=4
SCANNER_MAX_UPLOAD_MB=100
SCANNER_MAX_MEGAPIXELS=100
SCANNER_MAX_PDF_PAGES=300
SCANNER_JOB_TIMEOUT_S=300
SCANNER_CLAMD_TIMEOUT_S=60
SCANNER_YARA=reject

# ---- pdf-to-image (port 8082 inside) ----
CONVERTER_KEY=replace-with-a-random-string-of-at-least-32-characters
CONVERTER_MAX_CONCURRENCY=1
CONVERTER_QUEUE_SIZE=4
CONVERTER_MAX_UPLOAD_MB=100
CONVERTER_MAX_PAGES=500
CONVERTER_MAX_MEGAPIXELS_PER_PAGE=100
CONVERTER_MAX_TOTAL_MEGAPIXELS=2000
CONVERTER_JOB_TIMEOUT_S=300

# ---- reader (port 8083 inside) ----
READER_KEY=replace-with-a-random-string-of-at-least-32-characters
READER_ALLOWED_HOSTS=your-bucket.example.com
# Keep 1 on this VPS: the card cutter needs about 1.4-1.5 GB per job while cutting (limit 3 GB)
READER_MAX_CONCURRENCY=1
READER_QUEUE_SIZE=4
READER_MAX_UPLOAD_MB=50
READER_MAX_MEGAPIXELS=100
READER_MAX_PAGES=100
READER_JOB_TIMEOUT_S=300
READER_FAST_BUDGET_S=20
READER_THOROUGH_BUDGET_S=90
READER_USE_PADDLE=true

# ---- quality-gate (port 8084 inside) ----
GATE_KEY=replace-with-a-random-string-of-at-least-32-characters
GATE_DEFAULT_PROFILE=generic
GATE_MAX_CONCURRENCY=2
GATE_QUEUE_SIZE=4
GATE_MAX_UPLOAD_MB=50
GATE_MAX_MEGAPIXELS=100
GATE_JOB_TIMEOUT_S=120

# ---- intake-worker (no port; pulls jobs from the database) ----
# Limited database login (see intake-worker/sql/proposal.sql): SELECT/UPDATE intake_jobs, INSERT worker_heartbeat only
INTAKE_DATABASE_URL=postgresql://intake_worker:CHANGE_ME@db.your-project.supabase.co:5432/postgres?sslmode=require
# 32 random bytes, base64:  python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
INTAKE_MASTER_KEY=
INTAKE_ALLOWED_HOSTS=your-project.supabase.co
# Keep 2 on this VPS: each thread may run the card cutter (limit 3.5 GB)
INTAKE_THREADS=2
AUTO_ENHANCE=true
