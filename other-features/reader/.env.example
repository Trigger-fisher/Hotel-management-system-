# Copy to .env on the server. Never commit the real file.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
READER_KEY=replace-with-a-random-string-of-at-least-32-characters
# Hosts /v1/read-url may download from (comma list, exact names, https only)
READER_ALLOWED_HOSTS=your-bucket.example.com
READER_MAX_CONCURRENCY=2
READER_QUEUE_SIZE=4
READER_MAX_UPLOAD_MB=50
READER_MAX_MEGAPIXELS=100
READER_MAX_PAGES=100
READER_JOB_TIMEOUT_S=300
READER_FAST_BUDGET_S=20
READER_THOROUGH_BUDGET_S=90
# Optional: path to tesseract and to a folder of *.traineddata (defaults: PATH and the system tessdata)
READER_TESSERACT=
READER_TESSDATA=
READER_USE_PADDLE=true
# Card cutter model for multi=true: vit_t = MobileSAM (default) or vit_b = Segment Anything, fetched and checked by scripts/get_model.py
READER_CARDCUT_ARCH=vit_t
READER_CARDCUT_MODEL=
# Photo check: YuNet (MIT) + SFace (Apache-2.0) from opencv_zoo, fetched and checked by scripts/get_face_models.py; the image sets it.
# Without the files every portrait is "unavailable" (no evidence either way). Face embeddings never leave memory.
READER_FACE_MODELS_DIR=
# Clarity and photo thresholds: defaults in app/thresholds.py; any of them can be set as READER_<name>, for example
# READER_CLARITY_DPI_UNCLEAR=150
# READER_FACE_MISMATCH_BELOW=0.15
# QR and barcode decoding: OFF (MJ, 5 Nov 2026: no QR for now). true turns the QR reading and its pairing evidence back on.
READER_READ_QR=false
# picture=later (two parts): background parts (model cut, pictures) at once, in their own pool so a form never waits; a finished
# picture waits this many seconds to be fetched from GET /v1/picture/{token}, then it is dropped
READER_BACKGROUND_CONCURRENCY=1
READER_PICTURE_SECONDS=600
# cards of one sheet read side by side, and edge-fitted side by side
READER_READ_THREADS=3
READER_CUT_THREADS=4
