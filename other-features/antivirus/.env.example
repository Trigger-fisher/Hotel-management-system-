# Copy to .env on the server. Never commit the real file.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SCANNER_KEY=replace-with-a-random-string-of-at-least-32-characters
# clamd address: unix:/path or tcp:host:port (empty = no virus engine, development only)
SCANNER_CLAMD=unix:/var/run/clamav/clamd.ctl
# Hosts the service may download from / upload to (comma list, exact names, https only)
SCANNER_ALLOWED_HOSTS=your-quarantine-bucket.example.com,your-clean-bucket.example.com
# report = leave the quarantine copy; delete = DELETE it via quarantineDeleteUrl when given
SCANNER_QUARANTINE_ACTION=report
# true = also remove plain web links (/URI actions) from PDFs
SCANNER_STRIP_URI=false
SCANNER_MAX_CONCURRENCY=2
SCANNER_QUEUE_SIZE=4
SCANNER_MAX_UPLOAD_MB=100
SCANNER_MAX_MEGAPIXELS=100
SCANNER_MAX_PDF_PAGES=300
SCANNER_JOB_TIMEOUT_S=300
SCANNER_CLAMD_TIMEOUT_S=60
# Second engine (local YARA rules): reject = a match refuses the file (code yara_match); report = match is only noted
# in X-Notes and the file is still disarmed; off = disabled
SCANNER_YARA=reject
