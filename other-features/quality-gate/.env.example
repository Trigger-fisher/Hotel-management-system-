# Copy to .env on the server. Never commit the real file.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GATE_KEY=replace-with-a-random-string-of-at-least-32-characters
GATE_DEFAULT_PROFILE=generic
GATE_MAX_CONCURRENCY=2
GATE_QUEUE_SIZE=4
GATE_MAX_UPLOAD_MB=50
GATE_MAX_MEGAPIXELS=100
GATE_JOB_TIMEOUT_S=120
# Threads one check may use (the whole-picture scores, the portrait hint and the cards of a multi-id photo run side by side).
# GATE_MAX_CONCURRENCY x GATE_CPU_THREADS should not exceed the cores the container is given.
GATE_CPU_THREADS=4
# Optional: override thresholds without changing code (JSON string or path of a JSON file), see app/profiles.py
GATE_THRESHOLDS=
