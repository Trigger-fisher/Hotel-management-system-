# Variable NAMES only. Real values go in db/.env.local, which is git-ignored. Never put a value in this file.
# These are SCRIPT-ONLY secrets (db/scripts). They are never read by the running app and never loaded by Next.js:
# the app refuses to start in production if one of these names is in its environment.
# What each one means: docs/ENVIRONMENT.md
# Nobody writes these by hand: `npm run db:cli -- setup` (run from web-app) makes them, appends only what is missing and prints no value.

# The superuser of HMS's OWN PostgreSQL instance (127.0.0.1:5433). Made when the instance is first initialised. Used by setup and nothing else.
PGSUPERUSER_URL=

# hms_owner: runs migrations, seeds and create-hotel (owns the platform schema and every hotel schema; may SET ROLE to the hotel roles).
PG_OWNER_URL=

# hms_owner on the test database hms_test (used by `npm run test:db`).
PG_TEST_OWNER_URL=

# A HOSTED database with no superuser (Supabase): the console role's DIRECT address (not the pooler), typed once by hand; `setup --hosted` reads it.
PG_CONSOLE_URL=

# hms_app on the hosted DIRECT address (made by `setup --hosted`): the base of the pooled DATABASE_URL on Vercel and the readiness check.
PG_APP_DIRECT_URL=
